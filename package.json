{
  "name": "@singleteam/peakcli",
  "version": "3.0.3",
  "description": "Elevate your development workflow with a suite of powerful tools designed for generating robust, production-ready web blanks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "peak": "dist/index.js"
  },
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"node dist/index.js\"",
    "remove": "npm unlink -g peakcli",
    "format": "biome check --write ./src",
    "biome:lint": "biome lint ./src",
    "biome:check": "biome check ./src",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:watch-ui": "vitest --config vitest.config.ts --ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nestjs",
    "nextjs",
    "cli",
    "pwa",
    "clean-architecture",
    "learn"
  ],
  "author": "illinpayne",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "env-paths": "^4.0.0",
    "fs-extra": "^11.3.4",
    "inquirer": "^13.1.0",
    "keygen": "^0.4.0",
    "keytar": "^7.9.0",
    "nanoid": "^5.1.7",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@swc/core": "^1.15.8",
    "@types/axios": "^0.9.36",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.9.9",
    "@types/set-cookie-parser": "^2.4.10",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "vitest-mock-extended": "^3.1.0"
  }
}